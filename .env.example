# Copy to .env.local for local development. On Vercel, set these under Project → Settings →
# Environment Variables (adding Supabase through the Vercel Marketplace sets its two for you).

# Supabase: Project Settings → API. The service role (secret) key can read and write everything,
# so it stays on the server and is never prefixed NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the "continue your reservation" links in emails. Any long random string, e.g. from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RESERVATION_SECRET=

# Resend: API Keys. Without it, emails are skipped (and noted in the server log).
RESEND_API_KEY=
# Must be on a domain verified in Resend
EMAIL_FROM="Wizardify <hello@wizardify.me>"

# Cloudflare Turnstile, the bot check on the drop form (optional: without them it's off)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: where links in emails point. Defaults to www.wizardify.me in production, the deployment's
# own address on previews, and the dev server locally.
SITE_URL=
